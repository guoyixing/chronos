{
  "name": "other-chronos",
  "version": "1.0.0",
  "description": "Chronos is a front-end plug-in for project management and resource management.",
  "author": "KeyboardDog",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/chronos.cjs",
  "module": "dist/chronos.js",
  "types": "dist/chronos.d.ts",
  "exports": {
    ".": {
      "types": "./dist/chronos.d.ts",
      "import": "./dist/chronos.js",
      "require": "./dist/chronos.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "chronos",
    "gantt",
    "project management",
    "resource management",
    "konva",
    "canvas"
  ],
  "scripts": {
    "dev": "vite dev",
    "lint": "eslint --fix --ext .ts ./src",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "inversify": "^6.0.0",
    "konva": "^9.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.2",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "inversify": "^6.0.2",
    "konva": "^9.3.5",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.5",
    "vite-plugin-dts": "^3.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/guoyixing/chronos.git"
  }
}
